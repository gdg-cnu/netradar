# demo: deterministic local fixtures; live: real backend, never silently falls back.
VITE_API_MODE=demo
# Backend base URL includes the API version.
VITE_API_BASE_URL=http://localhost:8000/api/v1
# Public Supabase URL and anon/publishable key only; never use a service-role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Final policy URLs must be published before enabling real sign-in.
VITE_TERMS_URL=
VITE_PRIVACY_URL=
