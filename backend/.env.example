# backend/.env 로 복사해서 사용합니다. .env는 Git에 올라가지 않습니다.
# 값이 없어도 서버는 켜지며, 공개 API(/heatmap, /events, /alerts/top, /config 등)는 동작합니다.

# Supabase 프로젝트 URL (Project Settings → API)
SUPABASE_URL=
# 로그인 토큰 확인·프로필 조회용 공개 키 (publishable / anon)
SUPABASE_PUBLISHABLE_KEY=
# 운행 기록 저장용 서버 전용 키 (secret / service_role). 절대 프론트나 Git에 넣지 않습니다.
SUPABASE_SECRET_KEY=
# v1 동선 추천의 도로 경로 조회용 카카오모빌리티 REST API 키
KAKAO_MOBILITY_REST_API_KEY=
