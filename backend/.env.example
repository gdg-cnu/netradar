# backend/.env 로 복사해서 사용합니다. .env는 Git에 올라가지 않습니다.
# 값이 없어도 서버는 켜지며, 공개 API(/heatmap, /events, /alerts/top, /config 등)는 동작합니다.

# Supabase 프로젝트 URL (Project Settings → API)
SUPABASE_URL=
# 로그인 토큰 확인·프로필 조회용 공개 키 (publishable / anon)
SUPABASE_PUBLISHABLE_KEY=
# 운행 기록 저장용 서버 전용 키 (secret / service_role). 절대 프론트나 Git에 넣지 않습니다.
SUPABASE_SECRET_KEY=
# v1 동선 추천의 도로 경로 조회용 카카오모빌리티 REST API 키
KAKAO_MOBILITY_REST_API_KEY=
# 프런트엔드 주소(CORS 허용). 여러 개면 쉼표로 구분합니다. 비우면 로컬 개발 주소(localhost:5173, 4173)만 허용합니다.
# 예: ALLOWED_ORIGINS=https://netradar.example.com,http://localhost:5173
ALLOWED_ORIGINS=

# --- 수집 스크립트 (backend/collectors). 로컬에서 직접 돌릴 때만 필요 ---
# 자동 수집은 GitHub Actions가 하며, 같은 이름의 값을 저장소 Actions secrets에 등록한다
# 서울 열린데이터광장 인증키 (실시간 도시데이터)
SEOUL_API_KEY=
# 공공데이터포털 인증키 (인천공항 승객예고). Decoding 키 권장, Encoding 키도 동작
DATA_GO_KR_KEY=
# KOPIS 공연예술통합전산망 인증키
KOPIS_API_KEY=
